* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf

# Frozen manifests hash exact bytes. Keep research sources and tabular
# artifacts stable across Windows, macOS, and Linux checkouts.
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.tsv text eol=lf
*.txt text eol=lf
*.log text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*SHA256SUMS text eol=lf

# Frozen evidence trees hash exact submitted/output bytes. Do not normalize
# their line endings when adding them to or checking them out from Git.
experiments/30_oracle_feasibility_frontier/** -text -eol
experiments/31_image_target_transport_atlas/** -text -eol
